# SQLite database file path
DB_PATH=./smsforwarder.db

# Public API bind address. Put behind Cloudflare / a reverse proxy that
# terminates TLS for smsforwarder-api.shuttlelab.org.
HTTP_ADDR=0.0.0.0:8090

# Per-user rate limit for /api/sms (requests per minute)
RATE_LIMIT_PER_MIN=60

# Shared Telegram bot (optional; enables the Telegram channel). Can also be set
# in the admin console — DB values override these env fallbacks. A changed token
# needs a restart (the bot long-polls from boot). BOT_USERNAME is without the @.
BOT_TOKEN=
BOT_USERNAME=

# Global broadcast target: a Telegram channel/group chat id (negative, e.g.
# -1001234567890). When set, every received SMS is also published there, in
# addition to each user's own delivery. 0 or empty disables. Can also be set in
# the admin console — the DB value overrides this env fallback (no restart
# needed for a change).
PUBLISH_CHAT_ID=0

# Admin console. Disabled unless BOTH user and password are set. Keep ADMIN_ADDR
# on localhost unless it is fronted by TLS — it is the operator console.
ADMIN_ADDR=127.0.0.1:8091
ADMIN_USER=
ADMIN_PASSWORD=
